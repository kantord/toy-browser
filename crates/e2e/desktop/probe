#!/usr/bin/env python3
"""An assistive technology, in as few lines as one can be written in.

    probe                  print the whole desktop tree and exit
    probe --press NAME     press the first node named NAME, then print the tree

It is the smallest thing that can answer the question the rest of this harness
exists for: can something that is not this browser, talking only the desktop's
own accessibility protocol, find out what is on the page and act on it.

The retry loop is not politeness. AccessKit attaches lazily — it builds and
registers a tree only once an assistive technology is on the bus — so the first
walk after connecting is expected to find nothing, and the tree appears a moment
after this program announces itself by enabling accessibility.
"""

import sys
import time

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi, GLib, Gio  # noqa: E402

# The one signal AccessKit reacts to. It is a D-Bus property on the bus service
# rather than a method, and setting it is exactly what a screen reader starting
# up does — which is the point: nothing here is a special path for testing.
def announce():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    asked = GLib.Variant(
        "(ssv)", ("org.a11y.Status", "IsEnabled", GLib.Variant("b", True))
    )
    bus.call_sync(
        "org.a11y.Bus", "/org/a11y/bus", "org.freedesktop.DBus.Properties", "Set",
        asked, None, Gio.DBusCallFlags.NONE, 2000, None,
    )


def walk(node, depth, out):
    out.append("%s%s\t%s" % ("  " * depth, node.get_name() or "", node.get_role_name()))
    for i in range(node.get_child_count()):
        child = node.get_child_at_index(i)
        if child is not None:
            walk(child, depth + 1, out)


def pressed(node, name):
    """Depth-first, and the first match wins — the same one a reader would land
    on walking the page from the top."""
    if node.get_name() == name:
        action = node.get_action_iface()
        if action is not None and action.get_n_actions() > 0:
            action.do_action(0)
            return True
    for i in range(node.get_child_count()):
        child = node.get_child_at_index(i)
        if child is not None and pressed(child, name):
            return True
    return False


def main():
    wanted = sys.argv[2] if len(sys.argv) >= 3 and sys.argv[1] == "--press" else None
    Atspi.init()
    try:
        announce()
    except Exception as error:  # noqa: BLE001
        print("probe: could not turn accessibility on: %s" % error, file=sys.stderr)

    for attempt in range(40):
        out = []
        walk(Atspi.get_desktop(0), 0, out)
        tree = "\n".join(out)
        if wanted is None:
            if any(line.strip() for line in out[1:]):
                print(tree)
                return 0
        elif pressed(Atspi.get_desktop(0), wanted):
            print(tree)
            return 0
        if attempt < 39:
            time.sleep(0.5)

    print(tree)
    if wanted is not None:
        print("probe: nothing named %r could be pressed" % wanted, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
