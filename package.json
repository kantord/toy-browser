{
  "name": "toy-browser",
  "private": true,
  "type": "module",
  "description": "A toy browser: HTML in, PNG out. Rust crate plus its Playwright acceptance tests.",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "cargo build",
    "render": "cargo run -- render tests/fixtures/*.html tests/fixtures/js/*.html",
    "serve": "cargo run -- serve",
    "test": "pnpm --filter @toy-browser/playwright test",
    "test:smoke": "pnpm --filter @toy-browser/playwright test:smoke",
    "ui": "pnpm --filter @toy-browser/playwright ui",
    "report": "pnpm --filter @toy-browser/playwright report"
  }
}
